{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/QtLearnCodeLab/qtpi-shared/main/firmware/schema/manifest-v2.schema.json",
  "title": "QtPi firmware catalog v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "boards"],
  "properties": {
    "schemaVersion": {"const": 2},
    "updatedAt": {"type": "string", "format": "date-time"},
    "boards": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/board"}
    }
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "downloadUrl", "sha256", "sizeBytes"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "downloadUrl": {"type": "string", "format": "uri"},
        "offset": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
        "format": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 1}
      },
      "oneOf": [{"required": ["offset"]}, {"required": ["format"]}]
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "releaseDate", "images"],
      "properties": {
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "releaseDate": {"type": "string", "format": "date"},
        "releaseUrl": {"type": "string", "format": "uri"},
        "metadataStatus": {"enum": ["release-descriptor", "legacy"]},
        "images": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/image"}}
      }
    },
    "flavor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flavorId", "displayName", "defaultVersion", "versions"],
      "properties": {
        "flavorId": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "defaultVersion": {"type": "string"},
        "latestUrl": {"type": "string", "format": "uri"},
        "versions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/version"}}
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boardId", "displayName", "mcuFamily", "protocol", "flavors"],
      "properties": {
        "boardId": {"type": "string", "minLength": 1},
        "displayName": {"type": "string", "minLength": 1},
        "mcuFamily": {"type": "string", "minLength": 1},
        "protocol": {"type": "string", "minLength": 1},
        "flavors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/flavor"}}
      }
    }
  }
}
