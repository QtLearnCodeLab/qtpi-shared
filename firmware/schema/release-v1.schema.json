{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/QtLearnCodeLab/qtpi-shared/main/firmware/schema/release-v1.schema.json",
  "title": "QtPi firmware release descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "boardId", "flavorId", "version", "source", "dependencies", "images", "requiresErase"],
  "properties": {
    "schemaVersion": {"const": 1},
    "boardId": {"type": "string", "minLength": 1},
    "flavorId": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "commit", "tag"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tag": {"type": ["string", "null"]}
      }
    },
    "dependencies": {"type": "object", "additionalProperties": {"type": "string"}},
    "images": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/image"}
    },
    "flash": {"type": "object"},
    "requiresErase": {"type": "boolean"}
  },
  "$defs": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "file", "offset", "sha256", "sizeBytes"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "file": {"type": "string", "minLength": 1},
        "offset": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "sizeBytes": {"type": "integer", "minimum": 1},
        "contains": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "offset", "sizeBytes"],
            "properties": {
              "role": {"type": "string", "minLength": 1},
              "offset": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
              "sizeBytes": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
